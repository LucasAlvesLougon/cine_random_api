# Chave secreta para assinatura dos tokens JWT (obrigatória em produção com no mínimo 32 caracteres)
SECRET_KEY=sua_chave_secreta_super_segura_de_no_minimo_32_caracteres

# Algoritmo de criptografia do token (Padrão: HS256)
ENVIRONMENT=development
ALLOW_DEMO_AUTH=false

ALGORITHM=HS256

# Tempo de expiração do Token em minutos (Padrão: 10080 = 7 dias)
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# URL de conexão com o banco de dados
DATABASE_URL=sqlite:///./cine_random.db
# Para PostgreSQL em produção: postgresql+psycopg://usuario:senha@host:5432/nome_banco

# Client ID do Google OAuth 2.0 para validação server-side
GOOGLE_CLIENT_ID=seu_client_id.apps.googleusercontent.com

# URL pública usada nos links de convite e recuperação de senha
FRONTEND_BASE_URL=http://localhost:5173

# Credencial server-side do TMDB; não exponha no frontend
TMDB_API_KEY=sua_chave_tmdb
# Alternativamente, use o API Read Access Token v4
# TMDB_API_READ_ACCESS_TOKEN=seu_token_tmdb

# SMTP para recuperação de senha
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=usuario
SMTP_PASSWORD=senha
PASSWORD_RESET_FROM_EMAIL=no-reply@example.com
